{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "python -m pytest tests/unit -q",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Sanity Check",
      "type": "shell",
      "command": "python -m pytest tests/unit -q; python main.py --version",
