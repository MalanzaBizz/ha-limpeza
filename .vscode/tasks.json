      "problemMatcher": []
    },
    {
      "label": "Security Audit",
      "type": "shell",
      "command": "python -m pip_audit",
      "problemMatcher": []
    },
    {
      "label": "Setup Dev Environment",
      "type": "shell",
      "command": "python -m pip install -e \".[dev]\"",
      "problemMatcher": []
    }
  ]
}
